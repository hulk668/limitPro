# ---------------------------------------------------------------------------
# limitPro 环境变量示例 —— 复制为 .env.local 后按需修改
# 注意：真实的邮箱账号 / 密码 **不要** 写在这里，
#       而是在应用界面「邮箱管理」中录入（会以 AES-256-GCM 加密落盘）。
# ---------------------------------------------------------------------------

# 数据目录（账号、验证码历史、密钥环）。留空则使用 <进程工作目录>/.data
# 这是数据目录的**唯一权威来源**：界面的「打开数据目录」与「关于 → 本地数据与安全」
# 都直接使用该值，不再由前端或 Electron 主进程另行拼接路径。
# 必须是绝对路径，例如：LIMITPRO_DATA_DIR=E:\limitPro-data
LIMITPRO_DATA_DIR=

# 日志级别：debug | info | warn | error
LIMITPRO_LOG_LEVEL=debug

# Next.js 服务监听配置（Electron 会在生产模式下自动分配空闲端口）
PORT=3210
HOSTNAME=127.0.0.1

# ------------------------------- 2925 邮箱 IMAP 默认参数 -------------------
LIMITPRO_IMAP_HOST=imap.2925.com
LIMITPRO_IMAP_PORT=993
# true=993 SSL/TLS；若连接失败可改为 false + 143（2925 部分线路仅支持明文 143）
LIMITPRO_IMAP_SECURE=true
# 2925 不支持 IMAP SEARCH 命令，必须按序号 FETCH 后在本地过滤
LIMITPRO_IMAP_DISABLE_SEARCH=true
# 连接 / 指令超时（毫秒）
LIMITPRO_IMAP_TIMEOUT_MS=20000
# 部分邮箱证书链不完整时可置为 true 跳过 TLS 证书校验（默认关闭，不推荐）
LIMITPRO_IMAP_ALLOW_INVALID_CERT=false

# 默认拉取的最大邮件条数
LIMITPRO_MAIL_FETCH_LIMIT=30
