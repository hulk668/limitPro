# ---------------------------------------------------------------------------
# npm / pnpm 通用配置
# 注意：包管理与构建脚本相关设置请写在 pnpm-workspace.yaml 中
# ---------------------------------------------------------------------------

# Electron 二进制与 electron-builder 依赖走国内镜像，避免下载超时
# 若 cdn 线路不通，可换回 https://npmmirror.com/mirrors/electron/
electron_mirror=https://cdn.npmmirror.com/binaries/electron/
electron_builder_binaries_mirror=https://cdn.npmmirror.com/binaries/electron-builder-binaries/
