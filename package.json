{
  "name": "limitpro",
  "version": "0.1.0",
  "private": true,
  "description": "limitPro —— 邮箱验证码精准提取 + 随机账号密码生成的全栈桌面工具 (Next.js + Electron)",
  "main": "electron/main.js",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "dev": "concurrently -k -n NEXT,ELECTRON -c cyan,magenta \"cross-env PORT=3210 next dev\" \"wait-on tcp:127.0.0.1:3210 && cross-env ELECTRON_START_URL=http://127.0.0.1:3210 electron .\"",
    "dev:next": "cross-env PORT=3210 next dev",
    "dev:electron": "wait-on tcp:127.0.0.1:3210 && cross-env ELECTRON_START_URL=http://127.0.0.1:3210 electron .",
    "dev:web": "cross-env PORT=3210 next dev",
    "build": "next build && node scripts/prepare-standalone.mjs",
    "start:web": "cross-env NODE_ENV=production PORT=3210 node .next/standalone/server.js",
    "start:electron": "cross-env NODE_ENV=production electron .",
    "dist": "node scripts/electron-cache-guard.mjs && pnpm build && node scripts/pack.mjs",
    "dist:win": "node scripts/electron-cache-guard.mjs && pnpm build && node scripts/pack.mjs --win",
    "dist:mac": "node scripts/electron-cache-guard.mjs && pnpm build && node scripts/pack.mjs --mac",
    "icons": "node scripts/make-icons.mjs",
    "typecheck": "tsc --noEmit",
    "test:extractor": "node --experimental-strip-types --no-warnings scripts/test-extractor.mjs",
    "smoke": "node scripts/smoke-test.mjs",
    "verify:ui": "node scripts/ui-verify.mjs",
    "verify:open-dir": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-open-dir.ps1"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "imapflow": "^1.0.164",
    "lucide-react": "^1.47.0",
    "mailparser": "^3.7.1",
    "next": "^15.0.0",
    "next-themes": "^0.4.6",
    "postcss": "^8.5.28",
    "radix-ui": "^1.6.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@types/mailparser": "^3.4.5",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.2",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.limitpro.desktop",
    "productName": "limitPro",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "build-assets"
    },
    "files": [
      "electron/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "app/.next/standalone"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": ["arm64", "x64"]
        },
        {
          "target": "zip",
          "arch": ["arm64", "x64"]
        }
      ],
      "category": "public.app-category.productivity",
      "icon": "build-assets/icon.icns",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "identity": "-",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "notarize": false,
      "entitlements": "build-assets/entitlements.mac.plist",
      "entitlementsInherit": "build-assets/entitlements.mac.plist"
    },
    "dmg": {
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    }
  }
}
